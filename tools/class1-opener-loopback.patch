 EipStatus IfaceGetMacAddress(const char *iface,
                              uint8_t *const physical_address) {
+#ifdef __APPLE__
+  struct ifaddrs *list;
+  if(getifaddrs(&list) < 0) return kEipStatusError;
+  EipStatus status = kEipStatusError;
+  for(struct ifaddrs *it = list; it; it = it->ifa_next) {
+    if(it->ifa_addr && it->ifa_addr->sa_family == AF_LINK && strcmp(it->ifa_name, iface) == 0) {
+      struct sockaddr_dl *link = (struct sockaddr_dl *)it->ifa_addr;
+      memset(physical_address, 0, 6);
+      if(link->sdl_alen == 6) memcpy(physical_address, LLADDR(link), 6);
+      status = kEipStatusOk;
+      break;
+    }
+  }
+  freeifaddrs(list);
+  return status;
+#else
